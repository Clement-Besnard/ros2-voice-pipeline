# Copy to .env next to docker-compose.yml, then: docker compose up -d
# .env is gitignored, this file is the documented template.

# Address the services listen on.
#   127.0.0.1  nodes run on the same machine as the containers (default)
#   10.8.0.1   the GPU server's VPN address — current setup
#   0.0.0.0    every interface; Whisper and Kokoro do not authenticate at all,
#              so trusted networks only
BIND_ADDR=10.8.0.1

# Host n8n believes it is reachable at, for the editor and webhook URLs it
# hands you. Leave it as localhost when you browse n8n on the machine running
# it; set it to the address you actually type otherwise.
N8N_HOST=10.8.0.1

# Timezone for n8n's Schedule Trigger node and the container clock.
TZ=Europe/Paris

# If n8n's webhook URLs must be reachable under a different base than
# http://$N8N_HOST:5678, set it explicitly:
# WEBHOOK_URL=http://10.8.0.1:5678

# --- n8n owner account (optional) ---------------------------------------
# n8n has required a login since 1.0 and there is no supported way to turn it
# off. These variables only skip the signup form: n8n creates the owner at
# startup instead, so a fresh server comes up ready. Leave N8N_OWNER_MANAGED
# at false to go through the form by hand; the other four are then ignored.
#
# Only for an instance that has no owner yet. If one already exists, use that
# same email here — a different one is refused.
#
# The password goes in as a bcrypt hash, never in clear. Generate it with:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB -C 10 x 'YourPassword' | cut -d: -f2
# or, if python3-bcrypt is installed:
#   python3 -c "import bcrypt,getpass; print(bcrypt.hashpw(getpass.getpass().encode(), bcrypt.gensalt(10)).decode())"
# You get a 60-character string starting with $2a$, $2b$ or $2y$. Doubling the
# dollar signs is required, otherwise Compose eats them as variables.
# n8n requires at least 8 characters, one digit and one capital.
#
# Without SMTP there is no password reset: keep the password in your manager.
N8N_OWNER_MANAGED=false
# The address is only an identifier, no mail is ever sent — but n8n validates
# the format, so it needs a real domain with a TLD. `clem@local` is refused
# and crashes the container on startup.
# N8N_OWNER_EMAIL=clem@example.com
# N8N_OWNER_FIRST_NAME=Clement
# N8N_OWNER_LAST_NAME=Besnard
# N8N_OWNER_PASSWORD_HASH=$$2b$$10$$replace.this.with.your.own.hash

# --- Workflow bootstrap -------------------------------------------------
# On every `docker compose up`, the n8n-init container imports everything in
# n8n/credentials/ and n8n/workflows/ into the instance, and publishes the
# workflows whose JSON says "active": true. It needs an owner account to exist
# first: either N8N_OWNER_MANAGED=true above, or one you created by hand.
#
# The repository wins. Workflows are matched on their fixed id and overwritten,
# so edits made in the browser are undone on the next `up`. Export the workflow
# back into n8n/workflows/ to keep them, or set this to false.
N8N_BOOTSTRAP=true

# Where n8n reaches Ollama, and which model the Ollama Chat Model node runs.
# Both are substituted into the JSON under n8n/, which is why they belong here
# and not in the workflow file. Ollama is not part of this stack.
#   http://host.docker.internal:11434  Ollama on the Docker host (the default)
#   http://10.8.0.1:11434              Ollama bound to the VPN address
# The first only works if Ollama listens on more than 127.0.0.1 (see
# OLLAMA_HOST). Easiest is to match what the ROS llm_node already points at.
N8N_OLLAMA_URL=http://10.8.0.1:11434
N8N_OLLAMA_MODEL=qwen3:8b

# --- Whisper (speaches) -------------------------------------------------
# Model used for transcription. Speaches ships with none and installs nothing
# on its own: without it, every request gets a 404 and stt_node fails on each
# utterance. The speaches-init container downloads this one on `up` (~1.5 GB
# for the default) and skips it once the hf-hub-cache volume has it.
#
# This MUST match the `model` parameter of stt_node, which defaults to the same
# value in stt_node.py. They are separate programs; nothing checks they agree.
# Lighter alternatives: Systran/faster-distil-whisper-small.en,
# Systran/faster-whisper-tiny. `curl http://$BIND_ADDR:8001/v1/registry` lists
# everything available.
STT_MODEL=Systran/faster-distil-whisper-large-v3

# Seconds a model stays in VRAM after its last use. -1 never unloads it, so an
# idle pause costs no reload, at the price of holding the VRAM. 0 unloads
# immediately. Goes in as WHISPER__TTL: in Speaches 0.8.3 the setting is nested
# under WhisperConfig, and the flat STT_MODEL_TTL of 0.9.x is silently ignored.
WHISPER_TTL=300
